{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "title", "severity", "category", "scope", "detection_tier", "maps_to", "detection", "description", "remediation", "test_cases"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "informational"]
    },
    "category": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "enum": ["language-agnostic", "language-specific"] },
    "detection_tier": { "type": "string", "enum": ["regex", "context-aware", "ast"] },
    "ai_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["watch_for", "references", "related_rule_ids"],
      "properties": {
        "watch_for": { "type": "array", "items": { "type": "string" } },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url"],
            "properties": { "title": { "type": "string" }, "url": { "type": "string", "minLength": 1 } }
          }
        },
        "related_rule_ids": { "type": "array", "items": { "type": "string" } },
        "reasoning_notes": { "type": "string" }
      }
    },
    "maps_to": {
      "type": "object",
      "required": ["owasp"],
      "additionalProperties": false,
      "properties": {
        "owasp": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^A\\d{2}:\\d{4}$"
          }
        },
        "pdpa": {
          "type": "string",
          "pattern": "^Section\\s+\\d+"
        },
        "owasp_llm": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^LLM\\d{2}:20\\d{2}$"
          }
        },
        "atlas": {
          "type": "string",
          "pattern": "^AML\\.T\\d{4}$"
        },
        "cwe": {
          "type": "array",
          "items": { "type": "string", "pattern": "^CWE-\\d+$" }
        },
        "mitre_attack": {
          "type": "string",
          "pattern": "^T\\d{4}(\\.\\d{3})?$"
        }
      }
    },
    "detection": {
      "type": "object",
      "required": ["extensions", "conditions", "scope"],
      "additionalProperties": false,
      "properties": {
        "file_patterns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "extensions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pattern"],
            "additionalProperties": false,
            "properties": {
              "pattern": { "type": "string" },
              "flags": { "type": "string" },
              "negate": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        },
        "scope": {
          "type": "string",
          "enum": ["line", "file"]
        },
        "logic": {
          "type": "string",
          "enum": ["AND", "OR"]
        },
        "entropy_check": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "description": { "type": "string", "minLength": 1 },
    "remediation": { "type": "string", "minLength": 1 },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "fixture", "description"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["true_positive", "true_negative"]
          },
          "fixture": { "type": "string" },
          "description": { "type": "string" },
          "code": { "type": "string" }
        }
      }
    }
  }
}
