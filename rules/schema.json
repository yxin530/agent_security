{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "title", "severity", "category", "maps_to", "detection", "description", "remediation", "test_cases"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "informational"]
    },
    "category": { "type": "string", "minLength": 1 },
    "maps_to": {
      "type": "object",
      "required": ["owasp"],
      "additionalProperties": false,
      "properties": {
        "owasp": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^A\\d{2}:\\d{4}$"
          }
        },
        "pdpa": {
          "type": "string",
          "pattern": "^Section\\s+\\d+"
        }
      }
    },
    "detection": {
      "type": "object",
      "required": ["extensions", "conditions"],
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pattern"],
            "additionalProperties": false,
            "properties": {
              "pattern": { "type": "string" },
              "flags": { "type": "string" },
              "negate": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        },
        "scope": {
          "type": "string",
          "enum": ["line", "file"]
        },
        "logic": {
          "type": "string",
          "enum": ["AND", "OR"]
        },
        "entropy_check": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "description": { "type": "string", "minLength": 1 },
    "remediation": { "type": "string", "minLength": 1 },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "fixture", "description"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["true_positive", "true_negative"]
          },
          "fixture": { "type": "string" },
          "description": { "type": "string" },
          "code": { "type": "string" }
        }
      }
    }
  }
}
