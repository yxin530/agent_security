{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "findings", "summary", "scannedFiles", "scanDurationMs", "warnings", "truncated", "ruleMetadata"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "title", "severity", "category", "file", "line", "column", "message", "remediation", "fingerprint", "mapsTo", "detectionTier", "source"],
        "properties": {
          "ruleId": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "heuristic"] },
          "category": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 1 },
          "endLine": { "type": "integer", "minimum": 1 },
          "message": { "type": "string" },
          "remediation": { "type": "string" },
          "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
          "snippet": { "type": "string", "maxLength": 200 },
          "mapsTo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "owasp": { "type": "array", "items": { "type": "string", "pattern": "^A\\d{2}:\\d{4}$" } },
              "owasp_2021": { "type": "array", "items": { "type": "string", "pattern": "^A\\d{2}:2021$" } },
              "owasp_agentic": { "type": "array", "items": { "type": "string", "pattern": "^ASI(0[1-9]|10)$" } },
              "pdpa": { "type": "string", "pattern": "^Section\\s+\\d+" },
              "owasp_llm": { "type": "array", "items": { "type": "string", "pattern": "^LLM\\d{2}:20\\d{2}$" } },
              "atlas": { "type": "string", "pattern": "^AML\\.T\\d{4}$" },
              "cwe": { "type": "array", "items": { "type": "string", "pattern": "^CWE-\\d+$" } },
              "mitre_attack": { "type": "string", "pattern": "^T\\d{4}(\\.\\d{3})?$" }
            }
          },
          "detectionTier": { "type": "string", "enum": ["regex", "context-aware", "ast"] },
          "source": { "type": "string", "enum": ["static", "runtime"] }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low", "informational"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "informational": { "type": "integer", "minimum": 0 }
      }
    },
    "scannedFiles": { "type": "integer", "minimum": 0 },
    "scanDurationMs": { "type": "integer", "minimum": 0 },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "truncated": { "type": "boolean" },
    "ruleMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleCount"],
      "properties": { "ruleCount": { "type": "integer", "minimum": 0 } }
    },
    "output": {}
  }
}
