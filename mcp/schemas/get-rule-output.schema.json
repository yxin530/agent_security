{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["rulesetVersion", "rule"],
  "properties": {
    "rulesetVersion": { "type": "string" },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "severity", "category", "scope", "detection_tier", "maps_to", "detection", "description", "remediation", "test_cases"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational"] },
        "category": { "type": "string" },
        "scope": { "type": "string", "enum": ["language-agnostic", "language-specific"] },
        "detection_tier": { "type": "string", "enum": ["regex", "context-aware", "ast"] },
        "ai_guidance": { "type": "object" },
        "maps_to": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owasp": { "type": "array", "items": { "type": "string", "pattern": "^A\\d{2}:\\d{4}$" } },
            "pdpa": { "type": "string", "pattern": "^Section\\s+\\d+" },
            "owasp_llm": { "type": "array", "items": { "type": "string", "pattern": "^LLM\\d{2}:20\\d{2}$" } },
            "atlas": { "type": "string", "pattern": "^AML\\.T\\d{4}$" },
            "cwe": { "type": "array", "items": { "type": "string", "pattern": "^CWE-\\d+$" } },
            "mitre_attack": { "type": "string", "pattern": "^T\\d{4}(\\.\\d{3})?$" }
          }
        },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conditions", "scope"],
          "properties": {
            "file_patterns": { "type": "array" },
            "conditions": { "type": "array" },
            "scope": { "type": "string" },
            "logic": { "type": "string" },
            "entropy_check": { "type": "object" }
          }
        },
        "description": { "type": "string" },
        "remediation": { "type": "string" },
        "test_cases": { "type": "array" },
        "confidence": { "type": "string" },
        "detection_limitations": { "type": "string" }
      }
    }
  }
}
