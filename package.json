{
  "name": "@yxin530/agent-security-engine",
  "version": "0.8.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxin530/agent_security.git"
  },
  "homepage": "https://github.com/yxin530/agent_security",
  "bugs": {
    "url": "https://github.com/yxin530/agent_security/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/engine/scan.js",
  "bin": {
    "agent-security-engine": "bin/agent-security.js",
    "agent-security-monitor": "dist/monitor/cli.js",
    "agent-security-mcp": "bin/agent-security-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "monitor",
    "scripts",
    "tests/fixtures",
    "tests/adversarial",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "scan": "node dist/engine/scan.js",
    "validate:rules": "node dist/engine/loader.js --validate",
    "test:rules": "node dist/engine/test-runner.js",
    "verify:package": "sh scripts/verify-package.sh",
    "test": "node --test",
    "build": "tsc && mkdir -p dist/rules dist/docs/owasp dist/docs/frameworks dist/docs/agent-threats && cp -R rules/. dist/rules/ && cp docs/owasp/*.md dist/docs/owasp/ && cp docs/frameworks/*.md dist/docs/frameworks/ && cp docs/agent-threats/*.md dist/docs/agent-threats/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "8.20.0",
    "js-yaml": "5.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.1.2",
    "fast-check": "4.9.0",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  }
}
