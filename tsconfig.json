{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "core/**/*.ts",
    "matchers/**/*.ts",
    "cli/**/*.ts",
    "reporters/**/*.ts",
    "engine/**/*.ts",
    "monitor/**/*.ts",
    "mcp/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
